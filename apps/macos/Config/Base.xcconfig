// Build settings for the Keystead app. Signing lives in Signing.xcconfig.

PRODUCT_NAME = Keystead
PRODUCT_BUNDLE_IDENTIFIER = $(KEYSTEAD_BUNDLE_ID)

// Debug builds are a separate app ("Keystead Dev") with their own sandbox container,
// device key and data, so development can never touch a real vault. Both can be
// installed side by side.
PRODUCT_BUNDLE_IDENTIFIER[config=Debug] = $(KEYSTEAD_BUNDLE_ID).dev
MARKETING_VERSION = 0.7.0
CURRENT_PROJECT_VERSION = 8

SDKROOT = macosx
MACOSX_DEPLOYMENT_TARGET = 14.0
SWIFT_VERSION = 5.0

// A regular app with a main window and a menu bar icon. People who only want the menu bar
// icon can hide the Dock icon in Settings (see DockIcon in KeysteadApp.swift).
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = Keystead
INFOPLIST_KEY_CFBundleDisplayName[config=Debug] = Keystead Dev

// Icons are drawn by scripts/make-icons.swift. Debug builds get the orange DEV icon.
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_APPICON_NAME[config=Debug] = AppIcon-Dev
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.productivity

// The Hardened Runtime is required for notarization. The App Sandbox keeps the Mac App
// Store possible and limits what a compromised app could reach.
ENABLE_HARDENED_RUNTIME = YES
CODE_SIGN_ENTITLEMENTS = Config/Keystead.entitlements

// Xcode adds a debugging entitlement (get-task-allow) to development builds. Release
// builds must never carry it: notarization rejects apps that do.
CODE_SIGN_INJECT_BASE_ENTITLEMENTS[config=Release] = NO

// The Rust core build script writes outside Xcode's build folder.
ENABLE_USER_SCRIPT_SANDBOXING = NO

ALWAYS_SEARCH_USER_PATHS = NO
COMBINE_HIDPI_IMAGES = YES
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks

#include "Signing.xcconfig"
