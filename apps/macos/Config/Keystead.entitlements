<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Runs in the App Sandbox: its own container and nothing else on disk. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Talks to the Keystead server. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Prints the recovery kit. -->
	<key>com.apple.security.print</key>
	<true/>
	<!-- Reads a file the user chooses in an Open panel, and only that: an export to import,
	     or a screenshot of a one-time code's QR code. Writes the one they name in a Save
	     panel: an export of their logins, encrypted. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
