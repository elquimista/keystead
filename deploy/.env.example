# The server release to run: a tag from https://github.com/elquimista/keystead/tags,
# without the "v". Pinned, so the server changes only when you change this.
KEYSTEAD_VERSION=0.5.0

# The port the Keystead server listens on, on this machine's 127.0.0.1 only. nginx proxies
# to it; if you change it, change proxy_pass in keystead.nginx.conf to match.
KEYSTEAD_PORT=8080
